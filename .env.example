# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.
#
# Rule: only variables starting with NEXT_PUBLIC_ are sent to the browser.
# Every secret API key must NOT start with NEXT_PUBLIC_.

# --- Site ---------------------------------------------------------------------
# The public base URL of the site (no trailing slash). Locally:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Milestone 1+) --------------------------------------------------
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# Leave these empty to run on the bundled demo data only.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_…). A legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_…). A legacy "service_role" key also works.
# SERVER ONLY. It bypasses Row Level Security. Never expose it.
SUPABASE_SECRET_KEY=

# --- Later milestones (not needed yet) ----------------------------------------
# Milestone 4: films & TV search — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Milestone 4 & 6: music search + Now Playing — https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Milestone 6: caching — https://console.upstash.com (Redis → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
